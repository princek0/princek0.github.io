---
import EntryList from "../components/EntryList.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { other, timeline, work } from "../data/profile";
import BaseLayout from "../layouts/BaseLayout.astro";

const description = "Prince — path by age, work, and other projects.";
---

<BaseLayout title="About" {description}>
  <SiteHeader current="about" />

  <section class="page-section">
    <h2>Path by age</h2>
    <ul class="timeline">
      {
        timeline.map((entry) => (
          <li>
            <span class="age">{entry.age}</span>
            {entry.text}
          </li>
        ))
      }
    </ul>
  </section>

  <EntryList heading="Work" entries={work} />
  <EntryList heading="Other" entries={other} />

  <footer class="site-footer">
    <p>29.07.2026</p>
  </footer>
</BaseLayout>
