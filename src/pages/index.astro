---
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const description = "Prince — chess, mathematics, companies.";
---

<BaseLayout title="Prince" {description}>
  <SiteHeader current="home" showAlias={true} />

  <p class="lede">
    Currently working full-time at microagi. When I was younger, I built
    malware, represented Team England in the World Youth Chess Championships,
    and went to selective mathematics Olympiad camps. At 19 I became the
    youngest investor at a London-based early-stage venture fund, then went to
    Oxford to read mathematics. I dropped out in the first year of my
    undergraduate course.
  </p>

  <footer class="site-footer">
    <p>29.07.2026</p>
  </footer>
</BaseLayout>
