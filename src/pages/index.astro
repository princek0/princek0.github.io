---
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const description = "Prince — chess, mathematics, companies.";
---

<BaseLayout title="Prince" {description}>
  <SiteHeader current="home" showAlias={true} />

  <p class="lede">
    As a kid I played chess for England and competed in mathematics olympiads.
    At 19 I became the youngest investor at Entrepreneurs First, then went up to
    Oxford to read mathematics. I dropped out in my first year to work on
    microagi full time.
  </p>

  <footer class="site-footer">
    <p>29.07.2026</p>
  </footer>
</BaseLayout>
