---
import BaseLayout from "../layouts/BaseLayout.astro";

const description = "Prince — chess, mathematics, companies.";
---

<BaseLayout title="Prince" {description}>
  <header class="site-header site-header--home">
    <h1>Prince</h1>
    <p class="alias">Yuvraj Kumar</p>
  </header>

  <p class="lede">
    As a kid I played chess for England and competed in mathematics olympiads.
    At 19 I became the youngest investor at Entrepreneurs First, then went up to
    Oxford to read mathematics. I dropped out in my first year to work on
    microagi full time.
  </p>

  <section class="home-section">
    <h2>Writing</h2>
    <p><a href="/blog/">Blog</a></p>
  </section>

  <section class="home-section">
    <h2>Path by age</h2>
    <ul class="timeline">
      <li><span class="age">00</span>Born in New Delhi</li>
      <li><span class="age">03</span>Moved to London</li>
      <li><span class="age">07</span>Taught myself to code. Malware, first.</li>
      <li>
        <span class="age">12</span>Team England, World Youth Chess Championships
      </li>
      <li>
        <span class="age">15</span>Top 50 nationally in mathematics olympiads
      </li>
      <li>
        <span class="age">16</span>Offers from Britain's best boarding schools,
        on financial aid
      </li>
      <li>
        <span class="age">17</span>PROMYS Europe, six weeks of number theory at
        Oxford
      </li>
      <li><span class="age">18</span>Rationality camp, full scholarship</li>
      <li>
        <span class="age">19</span>Youngest investor at Entrepreneurs First,
        then up to Oxford
      </li>
      <li>
        <span class="age">now</span>Left in first year. Building at microagi
        full time.
      </li>
    </ul>
  </section>

  <section class="home-section">
    <h2>Record</h2>
    <ul class="plain-list">
      <li>
        Team England<span class="note"> — World Youth Chess Championships</span>
      </li>
      <li>British Chess Championships<span class="note"> — winner</span></li>
      <li>
        PROMYS Europe<span class="note">
          — top 30 in Europe, six weeks at Oxford</span
        >
      </li>
      <li>
        ASPR<span class="note">
          — rationality camp, top 30 globally, full scholarship</span
        >
      </li>
      <li>
        British Mathematical Olympiad<span class="note">
          — round 2 distinction, top 50 nationally</span
        >
      </li>
      <li>
        Maclaurin Olympiad<span class="note"> — silver, top 50 nationally</span>
      </li>
      <li>Pareto Fellow</li>
    </ul>
  </section>

  <section class="home-section">
    <h2>Work</h2>
    <ul class="plain-list">
      <li>microagi<span class="note"> — full time</span></li>
      <li>
        Bluedot Impact<span class="note">
          — Def/Acc operator, helping people start AI safety companies</span
        >
      </li>
      <li>
        Soda.io<span class="note">
          — growth, backed by Hummingbird and Point Nine</span
        >
      </li>
      <li>
        Entrepreneurs First<span class="note">
          — talent investment, originally invited as founder</span
        >
      </li>
    </ul>
  </section>

  <section class="home-section">
    <h2>Built</h2>
    <ul class="plain-list">
      <li>
        Varsity Hackathon<span class="note">
          — Oxford vs Cambridge, founder and director, $20,000 raised</span
        >
      </li>
      <li>
        Def/Acc, AI Security<span class="note">
          — hackathons organised with Bluedot Impact</span
        >
      </li>
      <li>
        Intrvue.ai<span class="note">
          — AI interviewer for 11+ admissions, revenue in a week</span
        >
      </li>
      <li>
        ProtocolML<span class="note">
          — real-time fraud detection for telecoms</span
        >
      </li>
      <li>Founderyoke<span class="note"> — matching for co-founders</span></li>
      <li>
        Gramira<span class="note">
          — instant LLM text correction in any text box</span
        >
      </li>
      <li>
        <a href="/pages/volution/">Volution</a><span class="note">
          — air-allergen sensors, a team of nine, I was CEO</span
        >
      </li>
      <li>
        Papers<span class="note">
          — fractional linear transformations, China's environmental policy</span
        >
      </li>
    </ul>
  </section>

  <section class="home-section">
    <h2>Elsewhere</h2>
    <ul class="plain-list">
      <li>
        Recurse Center<span class="note"> — programming retreat, New York</span>
      </li>
      <li>
        ARBOx3<span class="note">
          — machine learning alignment research bootcamp</span
        >
      </li>
      <li>
        Optiver European Chess Championship<span class="note">
          — finals, the only player still at school</span
        >
      </li>
      <li>
        Y Combinator AI Startup School<span class="note">
          — flown out to San Francisco</span
        >
      </li>
    </ul>
  </section>

  <footer class="site-footer">
    <p>29.07.2026</p>
  </footer>
</BaseLayout>
